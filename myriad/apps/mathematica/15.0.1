# New RHEL9 modules layout

lappend auto_path /apps/modulelibs/UsefulModuleFunctions
package require modulefunctions 1.0


proc ModulesHelp { } {
    puts stderr "Adds Mathematica 15.0.1 to your environment."
    puts stderr "Use wolfram for the CLI or WolframNB for the GUI."
    puts stderr "Mathematica is a general purpose package and language for"
    puts stderr "mathematical applications. It can be used for numerical"
    puts stderr "calculations, symbolic computation and visualization."
    puts stderr "Mathematica supports numbers of any precision."
    puts stderr ""
    puts stderr "Directory: /apps/Mathematica/15.0.1"
}

module-whatis "Adds Mathematica 15.0.1 to your environment."

# Location of Mathematica:

set version 15.0.1
set prefix /apps/Mathematica/$version
set userBase ~/Scratch/.Mathematica/$version

conflict mathematica

prepend-path	PATH			$prefix/bin
setenv 		WOLFRAM_BASE        $prefix
setenv 		WOLFRAM_USERBASE	$userBase

if { [modulefunctions::isModuleLoad] } {
    if { [modulefunctions::createDir $userBase] } {
        puts stderr "WOLFRAM_USERBASE directory is $userBase"
    } else {
        puts stderr "Problem setting up user base directory"
    }
}

# Use CPU binding for $ProcessorCount and MKLThreadNumber in a job or else set OMP_NUM_THREADS to 1 on login node.
if {[info exists ::env(SLURM_JOB_ID)]} {
    unsetenv OMP_NUM_THREADS
} else {
    setenv OMP_NUM_THREADS 1
}

if { [modulefunctions::isModuleLoad] } {
    if {[info exists ::env(DISPLAY)]} {
	puts stderr ""
	puts stderr "Mathematica configured."
	puts stderr ""
    }
}